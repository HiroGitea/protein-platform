# 复制为 .env 后按需修改。所有变量都有默认值，不配也能跑。

# 推理设备
PROTEIN_DEVICE=cuda

# 并发任务数。单卡建议保持 1，多个模型同时占显存容易 OOM
PROTEIN_MAX_CONCURRENT_JOBS=1

# 任务记录保留时长（小时）
PROTEIN_JOB_RETENTION_HOURS=24

# GenMol 权重文件名，放在 backend/checkpoints/ 下
PROTEIN_GENMOL_CHECKPOINT=model_v2.ckpt

# 允许跨域的前端地址，逗号分隔的 JSON 数组
PROTEIN_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
