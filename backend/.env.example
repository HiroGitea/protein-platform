# 复制为 .env 后按需修改。所有变量都有默认值，不配也能启动服务。

# ============ 远程 provider ============
# 免费 key 在 https://build.nvidia.com 注册获取。
# 配上它，GenMol / MolMIM / DiffDock / 结构预测 就能直接用官方托管 API，
# 不需要本地显卡。
NVIDIA_API_KEY=

# ============ provider 偏好 ============
# auto   = 本地可用就用本地，否则退远程（默认）
# local  = 只用本地 GPU
# remote = 只用官方托管 API
PROTEIN_GENMOL_PROVIDER=auto
PROTEIN_MOLMIM_PROVIDER=auto
PROTEIN_DIFFDOCK_PROVIDER=auto
PROTEIN_FOLD_PROVIDER=auto
PROTEIN_MMSEQS_PROVIDER=auto

# ============ 本地运行时 ============
PROTEIN_DEVICE=cuda

# 并发任务数。单卡建议保持 1，多个模型同时占显存容易 OOM
PROTEIN_MAX_CONCURRENT_JOBS=1

# 任务记录保留时长（小时）
PROTEIN_JOB_RETENTION_HOURS=24

# ============ 本地模型路径 ============
# GenMol 权重文件名，放在 backend/checkpoints/ 下
PROTEIN_GENMOL_CHECKPOINT=model_v2.ckpt

# MMseqs2 二进制。setup-mmseqs.sh 装到 third_party/bin 的话填绝对路径
PROTEIN_MMSEQS_BINARY=mmseqs

# ============ 其他 ============
PROTEIN_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
PROTEIN_REMOTE_TIMEOUT_SECONDS=300
